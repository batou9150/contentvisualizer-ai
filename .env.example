# Gemini API key (server only; never exposed to the browser)
GEMINI_API_KEY=

# OAuth 2.0 Web client (Google Cloud Console > APIs & Services > Credentials)
# Authorized JavaScript origins: http://localhost:5173 (dev) and your Cloud Run URL
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32+ random bytes used to encrypt the session cookie: `openssl rand -base64 32`
SESSION_SECRET=

# Optional: comma-separated allowlist of emails or @domains allowed to sign in (empty = anyone)
# ALLOWED_USERS=@example.com,alice@gmail.com

# Optional overrides
# PORT=3000
# TEXT_MODEL=gemini-3.8-flash
# IMAGE_MODEL=gemini-3.1-flash-image
